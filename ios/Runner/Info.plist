<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<!-- Analytics and crash reports only after opt-in (lib/core/analytics_consent.dart); no ads. -->
		<key>FirebaseCrashlyticsCollectionEnabled</key>
		<false/>
		<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
		<false/>
		<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_ANALYTICS_STORAGE</key>
		<false/>
		<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_STORAGE</key>
		<false/>
		<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_USER_DATA</key>
		<false/>
		<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_PERSONALIZATION_SIGNALS</key>
		<false/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<!-- Only HTTPS/TLS from the OS is used: exempt from export compliance
		     documentation, so App Store Connect doesn't ask on every upload. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>CFBundleDisplayName</key>
		<string>$(APP_DISPLAY_NAME)</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>SideQuest</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>NSContactsUsageDescription</key>
		<string>SideQuest gleicht deine Kontakte nur auf deinem Gerät ab, um dir Freunde vorzuschlagen. Kontakte werden nicht hochgeladen.</string>
		<key>NSCameraUsageDescription</key>
		<string>SideQuest braucht die Kamera, damit du Fotos für Quests und Duelle aufnehmen kannst.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>SideQuest nutzt das Mikrofon, um Live-Fotos optional mit Ton aufzunehmen.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>SideQuest braucht Zugriff auf deine Fotos, damit du Bilder auswählen kannst.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>SideQuest speichert Bilder in deiner Mediathek, wenn du sie exportierst.</string>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.892815395656-u36348aih70slvo805cps0vd3q6jnluk</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>io.supabase.sidequest</string>
				</array>
			</dict>
		</array>
	</dict>
</plist>
